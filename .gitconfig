[core]
    pager = delta
    compression = 0
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    dark = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictstyle = diff3

# [diff]
    # tool = difftastic
    # colorMoved = default
    # algorithm = histogram
[difftool]
    prompt = false
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[pager]
    difftool = true
[tag]
    sort = "version:refname"
[gpg]
    program = gpg
[alias]
    dft = difftool
    dlog = -c diff.external=delta log -p
    ddlog = -c diff.external=difft log -p --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
